<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LaVaquita.Views.vUnirseSala" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:models="clr-namespace:LaVaquita.Models" Title="Unirse"
    Style="{StaticResource VaquitaPage}">
    <ScrollView>
        <VerticalStackLayout
            Padding="22,20,22,36" HorizontalOptions="Center" MaximumWidthRequest="560" Spacing="15">
            <Border
                Padding="18" BackgroundColor="#24D6C8" HeightRequest="92" HorizontalOptions="Center"
                Rotation="-3" Stroke="#163832" StrokeShape="RoundRectangle 28" StrokeThickness="2"
                WidthRequest="92">
                <Image Source="people_icon.png" />
                <Border.Shadow>
                    <Shadow
                        Brush="#163832" Opacity="1" Radius="0" Offset="5,5" />
                </Border.Shadow>
            </Border>
            <Label Style="{StaticResource VaquitaEyebrow}" Text="YA TE ESTÁN ESPERANDO" />
            <Label Style="{StaticResource VaquitaTitle}" Text="Únete a la sala" />
            <Label Style="{StaticResource VaquitaSubtitle}" Text="Escanea el QR o escribe el código que compartió tu pana." />
            <Button
                Clicked="EscanearQr_Clicked" ContentLayout="Left,10" ImageSource="camera_icon.png"
                Style="{StaticResource VaquitaSecondaryButton}"
                Text="Escanear código QR" />
            <Label
                HorizontalTextAlignment="Start"
                Style="{StaticResource VaquitaEyebrow}"
                Text="CÓDIGO DE LA SALA" />
            <Border Style="{StaticResource VaquitaInputBorder}">
                <Entry
                    x:Name="CodigoEntry" CharacterSpacing="3" FontAttributes="Bold" FontSize="24"
                    HorizontalTextAlignment="Center" MaxLength="7" Placeholder="VACA-00"
                    Style="{StaticResource VaquitaEntry}"
                    TextChanged="Codigo_TextChanged" />
            </Border>
            <Label
                HorizontalTextAlignment="Start"
                Style="{StaticResource VaquitaEyebrow}"
                Text="TU NOMBRE" />
            <Border Style="{StaticResource VaquitaInputBorder}">
                <Entry
                    x:Name="NombreEntry" MaxLength="30" Placeholder="¿Cómo te llamas?"
                    Style="{StaticResource VaquitaEntry}" />
            </Border>
            <Label
                HorizontalTextAlignment="Start"
                Style="{StaticResource VaquitaEyebrow}"
                Text="ELIGE TU AVATAR" />
            <CollectionView
                x:Name="AvatarCollection" HeightRequest="116" SelectionMode="Single">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="9" Orientation="Horizontal" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:AvatarOption">
                        <Border
                            Padding="8" BackgroundColor="White" Stroke="#DCE5DB" StrokeShape="RoundRectangle 16"
                            WidthRequest="76">
                            <VerticalStackLayout>
                                <Image
                                    HeightRequest="48"
                                    Source="{Binding IconFile}"
                                    WidthRequest="48" />
                                <Label
                                    FontAttributes="Bold" FontSize="9" HorizontalTextAlignment="Center"
                                    Text="{Binding Nombre}"
                                    TextColor="#163832" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Border
                Padding="11" BackgroundColor="#DDF8F4" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="7">
                    <Image
                        HeightRequest="19" Source="sync_icon.png" WidthRequest="19" />
                    <Label
                        FontAttributes="Bold" FontSize="11" Text="Conexión segura y sin registro" TextColor="#27736A"
                        VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </Border>
            <Button
                x:Name="EntrarButton" Clicked="Entrar_Clicked" ContentLayout="Left,10" ImageSource="people_icon.png"
                Style="{StaticResource VaquitaButton}"
                Text="Entrar a la sala" />
            <ActivityIndicator
                x:Name="Cargando" IsRunning="False" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
