<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LaVaquita.Views.vJuegos" Style="{StaticResource VaquitaPage}" Title="Juegos">
    <ScrollView><VerticalStackLayout Padding="22,20,22,36" Spacing="15" MaximumWidthRequest="560" HorizontalOptions="Center">
        <Border Style="{StaticResource VaquitaPill}"><HorizontalStackLayout Spacing="6"><Image Source="sparkles_icon.svg" WidthRequest="16" HeightRequest="16"/><Label Text="MOMENTO DE DECIDIR" TextColor="#27736A" FontSize="10" FontAttributes="Bold" VerticalTextAlignment="Center"/></HorizontalStackLayout></Border>
        <Label Text="¿Cómo pagamos?" Style="{StaticResource VaquitaTitle}"/>
        <Label Text="Justo y parejo, o que decida la suerte." Style="{StaticResource VaquitaSubtitle}"/>
        <Border x:Name="DividirCard" BackgroundColor="#DDF8F4" Stroke="#163832" StrokeThickness="2" Padding="12" StrokeShape="RoundRectangle 18">
            <Border.Shadow><Shadow Brush="#163832" Offset="3,4" Radius="0" Opacity="1"/></Border.Shadow>
            <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="12">
                <Border BackgroundColor="White" Stroke="#163832" StrokeThickness="2" StrokeShape="RoundRectangle 18" Padding="13"><Image Source="people_icon.svg"/></Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center"><Label Text="MODO TRANQUI" FontSize="9" FontAttributes="Bold" TextColor="#478078"/><Label Text="Dividir" FontSize="23" FontAttributes="Bold" TextColor="#163832"/><Label x:Name="DivisionHintLabel" Text="Todos pagan por igual" FontSize="11" TextColor="#6B7C78"/></VerticalStackLayout>
                <ImageButton Grid.Column="2" x:Name="DividirButton" Source="arrow_right.svg" BackgroundColor="Transparent" WidthRequest="42" HeightRequest="42" Padding="8" Clicked="Dividir_Clicked"/>
            </Grid>
        </Border>
        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8"><BoxView HeightRequest="1" Color="#DCE5DB" VerticalOptions="Center"/><Label Grid.Column="1" Text="¿CON SUERTE?" FontSize="9" FontAttributes="Bold" TextColor="#6B7C78"/><BoxView Grid.Column="2" HeightRequest="1" Color="#DCE5DB" VerticalOptions="Center"/></Grid>
        <Border x:Name="RuletaCard" BackgroundColor="#FFF1C1" Stroke="#163832" StrokeThickness="2" Padding="12" StrokeShape="RoundRectangle 18">
            <Border.Shadow><Shadow Brush="#163832" Offset="3,4" Radius="0" Opacity="1"/></Border.Shadow>
            <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="10">
                <Image Source="roulette.svg" WidthRequest="65" HeightRequest="65"/>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center"><Label Text="MODO VALIENTE" FontSize="9" FontAttributes="Bold" TextColor="#8C6610"/><Label Text="Ruleta de Paga" FontSize="21" FontAttributes="Bold" TextColor="#163832"/><Label Text="Que el destino elija" FontSize="11" TextColor="#6B7C78"/></VerticalStackLayout>
                <ImageButton Grid.Column="2" x:Name="RuletaButton" Source="arrow_right.svg" BackgroundColor="Transparent" WidthRequest="42" HeightRequest="42" Padding="8" Clicked="Ruleta_Clicked"/>
            </Grid>
        </Border>
        <Border x:Name="DadosCard" BackgroundColor="#E2E7FF" Stroke="#163832" StrokeThickness="2" Padding="12" StrokeShape="RoundRectangle 18">
            <Border.Shadow><Shadow Brush="#163832" Offset="3,4" Radius="0" Opacity="1"/></Border.Shadow>
            <Grid ColumnDefinitions="72,*,Auto" ColumnSpacing="10">
                <Image Source="dice_big.svg" WidthRequest="66" HeightRequest="66"/>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center"><Label Text="JUEGO DE SUERTE" FontSize="9" FontAttributes="Bold" TextColor="#5064B1"/><Label Text="Dados" FontSize="22" FontAttributes="Bold" TextColor="#163832"/><Label Text="El número más alto paga" FontSize="11" TextColor="#6B7C78"/></VerticalStackLayout>
                <ImageButton Grid.Column="2" x:Name="DadosButton" Source="arrow_right.svg" BackgroundColor="Transparent" WidthRequest="42" HeightRequest="42" Padding="8" Clicked="Dados_Clicked"/>
            </Grid>
        </Border>
        <Border x:Name="EsperaPanel" IsVisible="False" BackgroundColor="#DDF8F4" StrokeThickness="0" Padding="18" StrokeShape="RoundRectangle 18"><VerticalStackLayout><Image Source="sync_icon.svg" WidthRequest="38" HeightRequest="38"/><Label Text="Esperando al anfitrión" FontAttributes="Bold" TextColor="#27736A" HorizontalTextAlignment="Center"/><Label Text="El juego aparecerá para todos al mismo tiempo" FontSize="11" TextColor="#27736A" HorizontalTextAlignment="Center"/></VerticalStackLayout></Border>
        <Border BackgroundColor="#EEF3E9" StrokeThickness="0" Padding="10" StrokeShape="RoundRectangle 99" HorizontalOptions="Center"><Label x:Name="ResumenLabel" FontSize="11" TextColor="#6B7C78"/></Border>
        <ActivityIndicator x:Name="Cargando" IsVisible="False" IsRunning="False"/>
    </VerticalStackLayout></ScrollView>
</ContentPage>
