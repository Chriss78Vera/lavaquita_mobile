<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:models="clr-namespace:LaVaquita.Models"
             x:Class="LaVaquita.Views.vCrearSala" Style="{StaticResource VaquitaPage}" Title="Crear sala">
    <ScrollView><VerticalStackLayout Padding="22,18,22,36" Spacing="15" MaximumWidthRequest="560" HorizontalOptions="Center">
        <Border Style="{StaticResource VaquitaPill}"><HorizontalStackLayout Spacing="6"><Image Source="sparkles_icon.svg" WidthRequest="16" HeightRequest="16"/><Label Text="PLAN ENTRE PANAS" TextColor="#27736A" FontSize="10" FontAttributes="Bold" VerticalTextAlignment="Center"/></HorizontalStackLayout></Border>
        <Label Text="¿Quién eres?" Style="{StaticResource VaquitaTitle}"/>
        <Label Text="Un nombre, un avatar y estás dentro." Style="{StaticResource VaquitaSubtitle}"/>
        <Grid HeightRequest="115">
            <Border WidthRequest="92" HeightRequest="92" BackgroundColor="#24D6C8" Stroke="#163832" StrokeThickness="2" StrokeShape="RoundRectangle 28" HorizontalOptions="Center" VerticalOptions="Center" Rotation="-3">
                <Image Source="vaquita_mascot.svg" Margin="5"/>
                <Border.Shadow><Shadow Brush="#163832" Offset="5,5" Radius="0" Opacity="1"/></Border.Shadow>
            </Border>
        </Grid>
        <Label Text="TU NOMBRE" Style="{StaticResource VaquitaEyebrow}" HorizontalTextAlignment="Start"/>
        <Border Style="{StaticResource VaquitaInputBorder}"><Entry x:Name="NombreEntry" Style="{StaticResource VaquitaEntry}" Placeholder="Escribe tu nombre" MaxLength="30"/></Border>
        <Label Text="ELIGE TU AVATAR" Style="{StaticResource VaquitaEyebrow}" HorizontalTextAlignment="Start" Margin="0,6,0,0"/>
        <CollectionView x:Name="AvatarCollection" SelectionMode="Single" HeightRequest="190">
            <CollectionView.ItemsLayout><GridItemsLayout Orientation="Vertical" Span="3" HorizontalItemSpacing="9" VerticalItemSpacing="9"/></CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate><DataTemplate x:DataType="models:AvatarOption">
                <Border BackgroundColor="White" Stroke="#DCE5DB" StrokeThickness="1" Padding="8" StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="3"><Image Source="{Binding IconFile}" HeightRequest="43" WidthRequest="43"/><Label Text="{Binding Nombre}" FontSize="10" FontAttributes="Bold" TextColor="#163832" HorizontalTextAlignment="Center"/></VerticalStackLayout>
                    <VisualStateManager.VisualStateGroups><VisualStateGroup Name="CommonStates"><VisualState Name="Normal"/><VisualState Name="Selected"><VisualState.Setters><Setter Property="Stroke" Value="#163832"/><Setter Property="StrokeThickness" Value="2"/><Setter Property="BackgroundColor" Value="#F4FFBE"/></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
                </Border>
            </DataTemplate></CollectionView.ItemTemplate>
        </CollectionView>
        <Button x:Name="CrearButton" Text="Crear sala" ImageSource="people_icon.svg" ContentLayout="Left,10" Style="{StaticResource VaquitaButton}" Clicked="Crear_Clicked"/>
        <ActivityIndicator x:Name="Cargando" IsVisible="False" IsRunning="False"/>
    </VerticalStackLayout></ScrollView>
</ContentPage>
