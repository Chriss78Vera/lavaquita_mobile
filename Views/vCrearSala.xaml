<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LaVaquita.Views.vCrearSala" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:models="clr-namespace:LaVaquita.Models" Title="Crear sala"
    Style="{StaticResource VaquitaPage}">
    <ScrollView>
        <VerticalStackLayout
            Padding="22,18,22,36" HorizontalOptions="Center" MaximumWidthRequest="560" Spacing="15">
            <Border Style="{StaticResource VaquitaPill}">
                <HorizontalStackLayout Spacing="6">
                    <Image
                        HeightRequest="16" Source="sparkles_icon.png" WidthRequest="16" />
                    <Label
                        FontAttributes="Bold" FontSize="10" Text="PLAN ENTRE PANAS" TextColor="#27736A"
                        VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </Border>
            <Label Style="{StaticResource VaquitaTitle}" Text="¿Quién eres?" />
            <Label Style="{StaticResource VaquitaSubtitle}" Text="Un nombre, un avatar y estás dentro." />
            <Grid HeightRequest="115">
                <Border
                    BackgroundColor="#24D6C8" HeightRequest="92" HorizontalOptions="Center" Rotation="-3"
                    Stroke="#163832" StrokeShape="RoundRectangle 28" StrokeThickness="2" VerticalOptions="Center"
                    WidthRequest="92">
                    <Image Margin="5" Source="vaquita_mascot.png" />
                    <Border.Shadow>
                        <Shadow
                            Brush="#163832" Opacity="1" Radius="0" Offset="5,5" />
                    </Border.Shadow>
                </Border>
            </Grid>
            <Label
                HorizontalTextAlignment="Start"
                Style="{StaticResource VaquitaEyebrow}"
                Text="TU NOMBRE" />
            <Border Style="{StaticResource VaquitaInputBorder}">
                <Entry
                    x:Name="NombreEntry" MaxLength="30" Placeholder="Escribe tu nombre"
                    Style="{StaticResource VaquitaEntry}" />
            </Border>
            <Label
                Margin="0,6,0,0" HorizontalTextAlignment="Start"
                Style="{StaticResource VaquitaEyebrow}"
                Text="ELIGE TU AVATAR" />
            <CollectionView
                x:Name="AvatarCollection" HeightRequest="190" SelectionMode="Single">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        HorizontalItemSpacing="9" Orientation="Vertical" Span="3" VerticalItemSpacing="9" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:AvatarOption">
                        <Border
                            Padding="8" BackgroundColor="White" Stroke="#DCE5DB" StrokeShape="RoundRectangle 16"
                            StrokeThickness="1">
                            <VerticalStackLayout Spacing="3">
                                <Image
                                    HeightRequest="43"
                                    Source="{Binding IconFile}"
                                    WidthRequest="43" />
                                <Label
                                    FontAttributes="Bold" FontSize="10" HorizontalTextAlignment="Center"
                                    Text="{Binding Nombre}"
                                    TextColor="#163832" />
                            </VerticalStackLayout>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="Stroke" Value="#163832" />
                                            <Setter Property="StrokeThickness" Value="2" />
                                            <Setter Property="BackgroundColor" Value="#F4FFBE" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <Button
                x:Name="CrearButton" Clicked="Crear_Clicked" ContentLayout="Left,10" ImageSource="people_icon.png"
                Style="{StaticResource VaquitaButton}"
                Text="Crear sala" />
            <ActivityIndicator
                x:Name="Cargando" IsRunning="False" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
