<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LaVaquita.Views.vRevisarCuenta"
             Style="{StaticResource VaquitaPage}"
             Title="Revisar cuenta">
    <ScrollView>
        <VerticalStackLayout Padding="22,24,22,36" Spacing="16" MaximumWidthRequest="560" HorizontalOptions="Center">
            <Border Style="{StaticResource VaquitaPill}">
                <HorizontalStackLayout Spacing="6">
                    <Image Source="check_icon.png" WidthRequest="16" HeightRequest="16"/>
                    <Label Text="LECTURA COMPLETADA" TextColor="#27736A" FontSize="10" FontAttributes="Bold" VerticalTextAlignment="Center"/>
                </HorizontalStackLayout>
            </Border>
            <Label Text="Revisa tu cuenta" Style="{StaticResource VaquitaTitle}"/>
            <Label Text="Confirma el total antes de repartirlo entre todos." Style="{StaticResource VaquitaSubtitle}"/>

            <Border BackgroundColor="#DDF8F4" Stroke="#163832" StrokeThickness="2" Padding="20" StrokeShape="RoundRectangle 22">
                <VerticalStackLayout Spacing="12">
                    <Image Source="receipt_scan.png" HeightRequest="120" Aspect="AspectFit"/>
                    <Label Text="TOTAL DETECTADO" Style="{StaticResource VaquitaEyebrow}"/>
                    <Border Style="{StaticResource VaquitaInputBorder}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label Text="$" FontSize="25" FontAttributes="Bold" TextColor="#163832" VerticalTextAlignment="Center" Margin="5,0"/>
                            <Entry Grid.Column="1" x:Name="TotalEntry" Style="{StaticResource VaquitaEntry}" Keyboard="Numeric" FontSize="27" HorizontalTextAlignment="Center"/>
                            <Label Grid.Column="2" Text="USD" FontSize="12" FontAttributes="Bold" TextColor="#27736A" VerticalTextAlignment="Center" Margin="0,0,8,0"/>
                        </Grid>
                    </Border>
                    <Label x:Name="ConfianzaLabel" Text="Confianza de lectura" FontSize="11" TextColor="#27736A" HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Border>

            <Button x:Name="ConfirmarButton" Text="Usar este total" ImageSource="check_icon.png" ContentLayout="Left,10" Style="{StaticResource VaquitaButton}" Clicked="Confirmar_Clicked"/>
            <Button Text="Cancelar y volver" Style="{StaticResource VaquitaSecondaryButton}" Clicked="Cancelar_Clicked"/>
            <ActivityIndicator x:Name="Cargando" IsVisible="False" IsRunning="False"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
