<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LaVaquita.Views.vResultado" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls" Title="Resultado"
    Style="{StaticResource VaquitaPage}">
    <Grid>
        <shapes:Ellipse
            Fill="#F4FFBE" HeightRequest="230" HorizontalOptions="Start" Opacity="0.7"
            TranslationX="-120" TranslationY="-110" VerticalOptions="Start" WidthRequest="230" />
        <ScrollView>
            <VerticalStackLayout
                Padding="22,20,22,36" HorizontalOptions="Center" MaximumWidthRequest="560" Spacing="15">
                <Grid HeightRequest="190">
                    <BoxView
                        CornerRadius="2" HeightRequest="18" HorizontalOptions="Start" Rotation="24"
                        TranslationX="55" TranslationY="25" VerticalOptions="Start" WidthRequest="8"
                        Color="#24D6C8" />
                    <BoxView
                        CornerRadius="2" HeightRequest="18" HorizontalOptions="End" Rotation="-30"
                        TranslationX="-45" TranslationY="35" VerticalOptions="Start" WidthRequest="8"
                        Color="#FF8A5B" />
                    <BoxView
                        CornerRadius="2" HeightRequest="18" HorizontalOptions="Start" Rotation="45"
                        TranslationX="75" TranslationY="-18" VerticalOptions="End" WidthRequest="8"
                        Color="#6D8DFF" />
                    <BoxView
                        CornerRadius="2" HeightRequest="18" HorizontalOptions="End" Rotation="-15"
                        TranslationX="-65" TranslationY="-22" VerticalOptions="End" WidthRequest="8"
                        Color="#B8F340" />
                    <Image
                        x:Name="HeroImage" HeightRequest="180" HorizontalOptions="Center" Source="vaquita_mascot.png"
                        WidthRequest="180" />
                </Grid>
                <Border Style="{StaticResource VaquitaPill}">
                    <Label
                        x:Name="EyebrowLabel" FontAttributes="Bold" FontSize="10" Text="LA SUERTE HABLÓ"
                        TextColor="#27736A" />
                </Border>
                <Label x:Name="TituloLabel" Style="{StaticResource VaquitaTitle}" />
                <Label x:Name="SubtituloLabel" Style="{StaticResource VaquitaSubtitle}" />
                <VerticalStackLayout
                    x:Name="DetallesLayout" Margin="0,5,0,0" Spacing="12" />
                <Border
                    Padding="12" BackgroundColor="#DDF8F4" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image
                            HeightRequest="25" Source="sync_icon.png" WidthRequest="25" />
                        <VerticalStackLayout Grid.Column="1">
                            <Label
                                FontAttributes="Bold" Text="Resultado sincronizado" TextColor="#27736A" />
                            <Label
                                FontSize="10" Text="Todos en la sala pueden verlo" TextColor="#27736A" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
                <Button
                    x:Name="DesempateButton" Clicked="Desempate_Clicked" ContentLayout="Left,10" ImageSource="dice_icon.png"
                    IsVisible="False"
                    Style="{StaticResource VaquitaSecondaryButton}"
                    Text="Lanzar desempate" />
                <Button
                    Clicked="Nueva_Clicked" ContentLayout="Left,10" ImageSource="refresh_icon.png"
                    Style="{StaticResource VaquitaDarkButton}"
                    Text="Nueva vaquita" />
                <ActivityIndicator
                    x:Name="Cargando" IsRunning="False" IsVisible="False" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
