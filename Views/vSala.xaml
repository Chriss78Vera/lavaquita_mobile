<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LaVaquita.Views.vSala" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Title="Sala"
    Style="{StaticResource VaquitaPage}">
    <ScrollView>
        <VerticalStackLayout
            Padding="20,16,20,36" HorizontalOptions="Center" MaximumWidthRequest="560" Spacing="15">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Border HorizontalOptions="Start" Style="{StaticResource VaquitaPill}">
                    <HorizontalStackLayout Spacing="6">
                        <BoxView
                            CornerRadius="4" HeightRequest="8" VerticalOptions="Center" WidthRequest="8"
                            Color="#24D6C8" />
                        <Label
                            x:Name="EstadoLabel" FontAttributes="Bold" FontSize="9" Text="EN VIVO"
                            TextColor="#27736A" />
                    </HorizontalStackLayout>
                </Border>
                <Border
                    Grid.Column="1" Padding="11,7" BackgroundColor="#EEF3E9" HorizontalOptions="End"
                    StrokeShape="RoundRectangle 99" StrokeThickness="0">
                    <Label
                        x:Name="CodigoLabel" CharacterSpacing="1.5" FontAttributes="Bold" FontSize="13"
                        TextColor="#163832" />
                </Border>
            </Grid>
            <Label
                x:Name="TituloSalaLabel"
                HorizontalTextAlignment="Start"
                Style="{StaticResource VaquitaTitle}"
                Text="La banda se arma" />
            <Label
                x:Name="ConteoLabel" HorizontalTextAlignment="Start"
                Style="{StaticResource VaquitaSubtitle}"
                Text="Participantes conectados" />
            <Border x:Name="QrPanel" Style="{StaticResource VaquitaCard}">
                <VerticalStackLayout Spacing="8">
                    <Border Style="{StaticResource VaquitaPill}">
                        <HorizontalStackLayout Spacing="6">
                            <BoxView
                                CornerRadius="4" HeightRequest="7" VerticalOptions="Center" WidthRequest="7"
                                Color="#24D6C8" />
                            <Label
                                FontAttributes="Bold" FontSize="9" Text="SALA LISTA" TextColor="#27736A"
                                VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <Image
                        x:Name="QrImage" HeightRequest="180" HorizontalOptions="Center" WidthRequest="180" />
                    <Label Style="{StaticResource VaquitaEyebrow}" Text="CÓDIGO DE LA SALA" />
                    <Label
                        x:Name="CodigoGrandeLabel" CharacterSpacing="3" FontAttributes="Bold" FontSize="28"
                        HorizontalTextAlignment="Center" TextColor="#163832" />
                    <Button
                        Clicked="CopiarCodigo_Clicked" ContentLayout="Left,8" ImageSource="copy_icon.png"
                        Style="{StaticResource VaquitaSecondaryButton}"
                        Text="Copiar código" />
                </VerticalStackLayout>
            </Border>
            <ScrollView HorizontalScrollBarVisibility="Never" Orientation="Horizontal">
                <HorizontalStackLayout
                    x:Name="ParticipantesLayout" Padding="2,3,8,8" Spacing="10" />
            </ScrollView>
            <Border
                Padding="12" BackgroundColor="#DDF8F4" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image
                        HeightRequest="29" Source="sync_icon.png" WidthRequest="29" />
                    <VerticalStackLayout Grid.Column="1">
                        <Label
                            x:Name="SyncTitleLabel" FontAttributes="Bold" Text="Conectando sala" TextColor="#27736A" />
                        <Label
                            x:Name="SyncDetailLabel" FontSize="10" Text="Preparando actualizaciones en vivo" TextColor="#27736A" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
            <Border
                x:Name="ParticipantePanel" Padding="18" BackgroundColor="#FFF1C1" IsVisible="False"
                Stroke="#163832" StrokeShape="RoundRectangle 22" StrokeThickness="2">
                <VerticalStackLayout Spacing="10">
                    <Image HeightRequest="110" Source="vaquita_mascot.png" />
                    <Label
                        FontAttributes="Bold" FontSize="24" HorizontalTextAlignment="Center"
                        Text="¡Ya estás dentro!" TextColor="#163832" />
                    <Label
                        x:Name="ParticipanteEsperaLabel" FontSize="13" HorizontalTextAlignment="Center"
                        Text="Espera a que el anfitrión confirme la cuenta e inicie el juego."
                        TextColor="#6B7C78" />
                </VerticalStackLayout>
            </Border>
            <Border
                x:Name="CuentaPanel" Padding="16" BackgroundColor="#DDF8F4" StrokeShape="RoundRectangle 22"
                StrokeThickness="0">
                <VerticalStackLayout Spacing="13">
                    <Grid HeightRequest="145" HorizontalOptions="Center" WidthRequest="207">
                        <Image Aspect="AspectFit" Source="receipt_ocr.png" />
                        <Grid
                            x:Name="LineaOcr" HeightRequest="10" HorizontalOptions="Center" InputTransparent="True"
                            VerticalOptions="Center" WidthRequest="126">
                            <BoxView Color="#FF694D" CornerRadius="1.5" HeightRequest="3" VerticalOptions="Center" />
                            <BoxView Color="#FF694D" CornerRadius="5" HeightRequest="10" HorizontalOptions="Start" WidthRequest="10" />
                            <BoxView Color="#FF694D" CornerRadius="5" HeightRequest="10" HorizontalOptions="End" WidthRequest="10" />
                        </Grid>
                    </Grid>
                    <Label
                        FontAttributes="Bold" FontSize="25" HorizontalTextAlignment="Center" Text="¿Cuánto fue?"
                        TextColor="#163832" />
                    <Label x:Name="AyudaFacturaLabel" Style="{StaticResource VaquitaSubtitle}" Text="Escanea la factura o escríbelo tú." />
                    <Grid x:Name="OpcionesOcr" ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border Padding="8" Style="{StaticResource VaquitaSoftCard}">
                            <Button
                                BackgroundColor="Transparent" Clicked="Camara_Clicked" ContentLayout="Top,5" FontAttributes="Bold"
                                ImageSource="camera_icon.png" Text="Cámara" TextColor="#163832" />
                        </Border>
                        <Border
                            Grid.Column="1" Padding="8"
                            Style="{StaticResource VaquitaSoftCard}">
                            <Button
                                BackgroundColor="Transparent" Clicked="Galeria_Clicked" ContentLayout="Top,5" FontAttributes="Bold"
                                ImageSource="gallery_icon.png" Text="Galería" TextColor="#163832" />
                        </Border>
                    </Grid>
                    <Label
                        x:Name="AvisoOcrLabel" FontSize="13" HorizontalTextAlignment="Center"
                        IsVisible="False" TextColor="#9B3023" />
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                        <BoxView
                            HeightRequest="1" VerticalOptions="Center" Color="#BCD7D2" />
                        <Label
                            Grid.Column="1" FontSize="10" Text="Monto manual" TextColor="#6B7C78" />
                        <BoxView
                            Grid.Column="2" HeightRequest="1" VerticalOptions="Center" Color="#BCD7D2" />
                    </Grid>
                    <Border x:Name="MontoManualPanel" Style="{StaticResource VaquitaInputBorder}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label
                                Margin="5,0" FontAttributes="Bold" FontSize="25" Text="$"
                                TextColor="#163832" VerticalTextAlignment="Center" />
                            <Entry
                                x:Name="TotalEntry" Grid.Column="1" FontSize="23" Keyboard="Numeric"
                                Placeholder="84.60"
                                Style="{StaticResource VaquitaEntry}" />
                            <ImageButton
                                Grid.Column="2" Padding="8" BackgroundColor="#B8F340" Clicked="ConfirmarTotal_Clicked"
                                CornerRadius="12" HeightRequest="46" Source="check_icon.png" WidthRequest="46" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>
            <Border
                x:Name="TotalConfirmadoPanel" BackgroundColor="#FFF1C1" IsVisible="False"
                Style="{StaticResource VaquitaCard}">
                <VerticalStackLayout>
                    <Image
                        HeightRequest="52" Source="check_icon.png" WidthRequest="52" />
                    <Label Style="{StaticResource VaquitaEyebrow}" Text="TOTAL CONFIRMADO" />
                    <Label
                        x:Name="TotalConfirmadoLabel" FontAttributes="Bold" FontSize="31" HorizontalTextAlignment="Center"
                        TextColor="#163832" />
                </VerticalStackLayout>
            </Border>
            <Button
                x:Name="ContinuarButton" Clicked="Continuar_Clicked"
                Style="{StaticResource VaquitaButton}"
                Text="Elegir cómo pagamos" />
            <Button
                x:Name="CerrarSalaButton" Clicked="CerrarSala_Clicked" ContentLayout="Left,10" ImageSource="close_icon.png"
                Style="{StaticResource VaquitaDarkButton}"
                Text="Cerrar sala" />
            <ActivityIndicator
                x:Name="Cargando" IsRunning="False" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
