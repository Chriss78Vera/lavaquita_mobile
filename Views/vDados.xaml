<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LaVaquita.Views.vDados" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Title="Dados"
    Style="{StaticResource VaquitaPage}">
    <ScrollView>
        <VerticalStackLayout
            Padding="22,20,22,36" HorizontalOptions="Center" MaximumWidthRequest="560" Spacing="15">
            <Border Style="{StaticResource VaquitaPill}">
                <Label
                    FontAttributes="Bold" FontSize="10" Text="JUEGO DE SUERTE" TextColor="#5064B1" />
            </Border>
            <Label Style="{StaticResource VaquitaTitle}" Text="Dados" />
            <Label Style="{StaticResource VaquitaSubtitle}" Text="El número más alto paga la cuenta." />

            <Border
                Padding="18" BackgroundColor="#E2E7FF" Stroke="#163832" StrokeShape="RoundRectangle 22"
                StrokeThickness="2">
                <VerticalStackLayout Spacing="12">
                    <Image
                        HeightRequest="150" Source="dice_big.png" WidthRequest="150" />
                    <Label Style="{StaticResource VaquitaEyebrow}" Text="UNA RONDA, UN GANADOR" />
                    <Label
                        x:Name="ReglaLabel" FontSize="13" HorizontalTextAlignment="Center" Text="El mayor número invita."
                        TextColor="#5064B1" />
                </VerticalStackLayout>
            </Border>

            <Border
                Padding="14" BackgroundColor="#FFFFFF" Stroke="#DCE5DB" StrokeShape="RoundRectangle 16"
                StrokeThickness="1">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Image
                        HeightRequest="28" Source="people_icon.png" WidthRequest="28" />
                    <Label
                        x:Name="ParticipantesLabel" Grid.Column="1" FontSize="12" TextColor="#6B7C78"
                        VerticalTextAlignment="Center" />
                </Grid>
            </Border>

            <Button
                x:Name="LanzarButton" Clicked="Lanzar_Clicked" ContentLayout="Left,10" ImageSource="dice_icon.png"
                Style="{StaticResource VaquitaButton}"
                Text="Mezclar y lanzar" />
            <ActivityIndicator
                x:Name="Cargando" IsRunning="False" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
