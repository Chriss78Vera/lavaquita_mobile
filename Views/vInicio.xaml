<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LaVaquita.Views.vInicio" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls" Title="La Vaquita"
    NavigationPage.HasNavigationBar="False"
    Style="{StaticResource VaquitaPage}">
    <ContentPage.Resources>
        <Style x:Key="AccionInicioSecundaria" TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderColor" Value="#27736A" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
            <Setter Property="MinimumHeightRequest" Value="48" />
            <Setter Property="TextColor" Value="#163832" />
        </Style>
    </ContentPage.Resources>
    <Grid BackgroundColor="#D9F3EC">
        <shapes:Ellipse
            Fill="#F4FFBE" HeightRequest="260" HorizontalOptions="Start" Opacity="0.8"
            TranslationX="-100" TranslationY="-80" VerticalOptions="Start" WidthRequest="260" />
        <shapes:Ellipse
            Fill="#BCE8FF" HeightRequest="260" HorizontalOptions="End" Opacity="0.75"
            TranslationX="100" TranslationY="90" VerticalOptions="End" WidthRequest="260" />
        <ScrollView>
            <VerticalStackLayout
                HorizontalOptions="Center" MaximumWidthRequest="560" Spacing="0" VerticalOptions="Center">
                <VerticalStackLayout Padding="24,34,24,10" Spacing="10">
                    <Border
                        Padding="12,7" BackgroundColor="#CCFFFFFF" HorizontalOptions="Center" StrokeShape="RoundRectangle 99"
                        StrokeThickness="0">
                        <HorizontalStackLayout Spacing="6">
                            <Image
                                HeightRequest="16" Source="sparkles_icon.png" WidthRequest="16" />
                            <Label
                                CharacterSpacing="0.5" FontAttributes="Bold" FontSize="10" Text="CUENTAS CLARAS, PANAS FELICES"
                                TextColor="#163832" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </Border>
                    <Grid HeightRequest="265">
                        <Border
                            Padding="20" BackgroundColor="#B8F340" HeightRequest="205" HorizontalOptions="Center"
                            Stroke="#163832" StrokeShape="RoundRectangle 30" StrokeThickness="3" VerticalOptions="Center"
                            WidthRequest="205">
                            <Border.Shadow>
                                <Shadow
                                    Brush="#163832" Opacity="1" Radius="0" Offset="8,8" />
                            </Border.Shadow>
                            <Image
                                Aspect="AspectFit" SemanticProperties.Description="Ícono de La Vaquita" Source="appiconfg.png" />
                        </Border>
                        <Border
                            Padding="6" BackgroundColor="#24D6C8" HeightRequest="43" HorizontalOptions="Start"
                            Stroke="#163832" StrokeShape="RoundRectangle 99" StrokeThickness="2" TranslationX="50"
                            TranslationY="32" VerticalOptions="Start" WidthRequest="43">
                            <Image Source="coin_icon.png" />
                        </Border>
                        <Border
                            Padding="7" BackgroundColor="#6D8DFF" HeightRequest="39" HorizontalOptions="End"
                            Stroke="#163832" StrokeShape="RoundRectangle 99" StrokeThickness="2" TranslationX="-48"
                            TranslationY="-30" VerticalOptions="End" WidthRequest="39">
                            <Image Source="sparkles_icon.png" />
                        </Border>
                    </Grid>
                    <Label
                        CharacterSpacing="6" FontAttributes="Bold" FontSize="15" HorizontalTextAlignment="Center"
                        Text="LA" TextColor="#163832" />
                    <Label
                        Margin="0,-10,0,0" FontAttributes="Bold" FontSize="46" HorizontalTextAlignment="Center"
                        Text="VAQUITA" TextColor="#163832" />
                    <Label
                        FontSize="14" HorizontalTextAlignment="Center" Text="La cuenta se paga entre todos" TextColor="#6B7C78" />
                </VerticalStackLayout>
                <Border
                    Padding="22,24,22,24" BackgroundColor="#FBFAF2" StrokeShape="RoundRectangle 30,30,0,0" StrokeThickness="0">
                    <VerticalStackLayout Spacing="14">
                        <Grid>
                            <VerticalStackLayout x:Name="OnlineOptions" Spacing="12">
                                <Button
                                    Clicked="CrearSala_Clicked" ContentLayout="Left,10" ImageSource="people_icon.png"
                                    Style="{StaticResource VaquitaButton}" Text="Crear una sala" />
                                <Button
                                    BackgroundColor="#DDF8F4" Clicked="Unirse_Clicked"
                                    ContentLayout="Left,8" ImageSource="arrow_right.png"
                                    Style="{StaticResource AccionInicioSecundaria}" Text="Unirme con código" />
                                <Button
                                    BackgroundColor="#FFF1C1" Clicked="ModoRapido_Clicked"
                                    ContentLayout="Left,8" ImageSource="dice_icon.png"
                                    Style="{StaticResource AccionInicioSecundaria}" Text="Modo rápido" />
                                <Label
                                    FontSize="11" Style="{StaticResource VaquitaSubtitle}"
                                    Text="Sin registro. Todos conectados." />
                            </VerticalStackLayout>

                            <VerticalStackLayout
                                x:Name="OfflineOptions" IsVisible="False" Spacing="16">
                                <Grid>
                                    <Button
                                        Clicked="ModoRapido_Clicked" HeightRequest="-1" MinimumHeightRequest="72"
                                        SemanticProperties.Description="{Binding Text, Source={x:Reference ModoRapidoSinConexionLabel}, x:DataType=Label}"
                                        Style="{StaticResource VaquitaButton}" />
                                    <Grid
                                        AutomationProperties.ExcludedWithChildren="True" ColumnDefinitions="*,Auto"
                                        ColumnSpacing="12" InputTransparent="True" Padding="20,12">
                                        <Label
                                            x:Name="ModoRapidoSinConexionLabel" FontAttributes="Bold" FontSize="21"
                                            Text="Modo rápido" TextColor="#163832" VerticalTextAlignment="Center" />
                                        <Image
                                            Grid.Column="1" HeightRequest="34" WidthRequest="34"
                                            Source="receipt_icon.png" VerticalOptions="Center" />
                                    </Grid>
                                </Grid>
                                <Label
                                    FontSize="12" HorizontalTextAlignment="Center"
                                    Text="Dados, ruleta y división funcionan sin internet y se guardan en este teléfono."
                                    TextColor="#6B7C78" />
                            </VerticalStackLayout>
                        </Grid>
                        <Border
                            x:Name="ServiceStatusPanel" Padding="13" BackgroundColor="#FFE1DE" IsVisible="False"
                            Stroke="#D94C42" StrokeShape="RoundRectangle 15" StrokeThickness="1">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Image HeightRequest="27" Source="close_icon.png" WidthRequest="27" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label
                                        FontAttributes="Bold" FontSize="13" Text="Servicios tomando un descanso"
                                        TextColor="#A82E28" />
                                    <Label
                                        FontSize="10" Text="El servidor se fue por un encebollado. Las salas paran un ratito, pero el modo rápido sigue de una."
                                        TextColor="#A82E28" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                        <Button
                            x:Name="ContinuarGuardadaButton" Clicked="ContinuarGuardada_Clicked"
                            ContentLayout="Left,9" HeightRequest="-1" ImageSource="refresh_icon.png" IsVisible="False"
                            LineBreakMode="WordWrap" MinimumHeightRequest="58" Padding="12,8"
                            Style="{StaticResource VaquitaSecondaryButton}"
                            Text="Continuar última vaquita" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
