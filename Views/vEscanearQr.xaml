<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LaVaquita.Views.vEscanearQr"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
    BackgroundColor="#0D2622"
    Title="Escanear QR">
    <Grid RowDefinitions="*,Auto">
        <zxing:CameraBarcodeReaderView
            x:Name="BarcodeView"
            BarcodesDetected="BarcodesDetected"
            IsDetecting="True" />

        <Grid InputTransparent="True" Padding="34">
            <VerticalStackLayout VerticalOptions="Center" Spacing="20">
                <Label
                    FontAttributes="Bold" FontSize="24" HorizontalTextAlignment="Center"
                    Text="Apunta al QR de la sala" TextColor="White" />
                <Border
                    BackgroundColor="Transparent" HeightRequest="260" HorizontalOptions="Center"
                    Stroke="#B8F340" StrokeShape="RoundRectangle 28" StrokeThickness="4"
                    WidthRequest="260" />
                <Label
                    FontSize="13" HorizontalTextAlignment="Center"
                    Text="El código se completará automáticamente"
                    TextColor="White" />
            </VerticalStackLayout>
        </Grid>

        <Border
            Grid.Row="1" Margin="18" Padding="14" BackgroundColor="#F7F7F2"
            Stroke="#163832" StrokeShape="RoundRectangle 22" StrokeThickness="2">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button
                    Clicked="Linterna_Clicked" ContentLayout="Left,8" ImageSource="camera_icon.png"
                    Style="{StaticResource VaquitaSecondaryButton}" Text="Linterna" />
                <Button
                    Grid.Column="1" Clicked="Cancelar_Clicked" ContentLayout="Left,8" ImageSource="close_icon.png"
                    Style="{StaticResource VaquitaDarkButton}" Text="Cancelar" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
