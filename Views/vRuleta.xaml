<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LaVaquita.Views.vRuleta" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Title="Ruleta"
    Style="{StaticResource VaquitaPage}">
    <ScrollView>
        <VerticalStackLayout
            Padding="22,20,22,36" HorizontalOptions="Center" MaximumWidthRequest="560" Spacing="15">
            <Border Style="{StaticResource VaquitaPill}">
                <Label
                    FontAttributes="Bold" FontSize="10" Text="MODO VALIENTE" TextColor="#8C6610" />
            </Border>
            <Label Style="{StaticResource VaquitaTitle}" Text="Ruleta de paga" />
            <Label Style="{StaticResource VaquitaSubtitle}" Text="Que el destino elija quién invita." />

            <Border
                Padding="18" BackgroundColor="#FFF1C1" Stroke="#163832" StrokeShape="RoundRectangle 22"
                StrokeThickness="2">
                <VerticalStackLayout Spacing="10">
                    <Label Style="{StaticResource VaquitaEyebrow}" Text="¿CUÁNTAS PERSONAS PAGAN?" />
                    <Grid
                        ColumnDefinitions="Auto,*,Auto" ColumnSpacing="24" HorizontalOptions="Center">
                        <Button
                            Padding="0" Clicked="Restar_Clicked" HeightRequest="52"
                            Style="{StaticResource VaquitaSecondaryButton}"
                            Text="−" WidthRequest="52" />
                        <VerticalStackLayout
                            Grid.Column="1" HorizontalOptions="Center" WidthRequest="90">
                            <Label
                                x:Name="CantidadLabel" FontAttributes="Bold" FontSize="44" HorizontalTextAlignment="Center"
                                Text="1" TextColor="#163832" />
                            <Label
                                x:Name="MaximoLabel" FontSize="12" HorizontalTextAlignment="Center" Text="de 3"
                                TextColor="#6B7C78" />
                        </VerticalStackLayout>
                        <Button
                            Grid.Column="2" Padding="0" Clicked="Sumar_Clicked" HeightRequest="52"
                            Style="{StaticResource VaquitaButton}"
                            Text="+" WidthRequest="52" />
                    </Grid>
                    <Label
                        x:Name="AyudaLabel" FontSize="11" HorizontalTextAlignment="Center" Text="Elegiremos a una persona valiente."
                        TextColor="#6B7C78" />
                </VerticalStackLayout>
            </Border>

            <Border
                Padding="16" BackgroundColor="#DDF8F4" StrokeShape="RoundRectangle 18" StrokeThickness="0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Image
                        HeightRequest="78" Source="roulette.png" WidthRequest="78" />
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold" FontSize="10" Text="TODOS SINCRONIZADOS" TextColor="#27736A" />
                        <Label
                            FontSize="12" Text="La ruleta se verá igual para toda la sala." TextColor="#27736A" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Button
                x:Name="GirarButton" Clicked="Girar_Clicked" ContentLayout="Left,10" ImageSource="sparkles_icon.png"
                Style="{StaticResource VaquitaButton}"
                Text="Girar la ruleta" />
            <ActivityIndicator
                x:Name="Cargando" IsRunning="False" IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
