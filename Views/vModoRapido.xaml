<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LaVaquita.Views.vModoRapido" xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Title="Modo rápido"
    xmlns:controls="clr-namespace:LaVaquita.Controls"
    xmlns:models="clr-namespace:LaVaquita.Models"
    xmlns:views="clr-namespace:LaVaquita.Views"
    Style="{StaticResource VaquitaPage}">
    <ContentPage.Resources>
        <Style x:Key="BotonParticipante" TargetType="Button" BasedOn="{StaticResource VaquitaSecondaryButton}">
            <Setter Property="HeightRequest" Value="44" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Shadow" Value="{x:Null}" />
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout
            Padding="22,18,22,36" HorizontalOptions="Center" MaximumWidthRequest="560" Spacing="16">
            <Border Style="{StaticResource VaquitaPill}">
                <HorizontalStackLayout Spacing="6">
                    <Image
                        HeightRequest="17" Source="people_icon.png" WidthRequest="17" />
                    <Label
                        FontAttributes="Bold" FontSize="10" Text="PASO 1 DE 3" TextColor="#27736A"
                        VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </Border>
            <Label Style="{StaticResource VaquitaTitle}" Text="¿Quiénes están?" />
            <Label Style="{StaticResource VaquitaSubtitle}" Text="Añade la banda y el total de la cuenta." />
            <Border Style="{StaticResource VaquitaCard}">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border
                            Padding="11" BackgroundColor="#24D6C8" HeightRequest="52" Stroke="#163832"
                            StrokeShape="RoundRectangle 16" StrokeThickness="2" WidthRequest="52">
                            <Image Source="people_icon.png" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold" FontSize="18" Text="Participantes" TextColor="#163832" />
                            <Label
                                x:Name="ConteoParticipantesLabel"
                                FontSize="11" Text="De 2 a 10 personas" TextColor="#6B7C78" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Border Style="{StaticResource VaquitaInputBorder}">
                            <Entry
                                x:Name="NombreEntry" Completed="AgregarNombre" ReturnType="Done"
                                Placeholder="Nombre o apodo" Style="{StaticResource VaquitaEntry}" />
                        </Border>
                        <Button
                            Grid.Column="1" Clicked="AgregarNombre"
                            Style="{StaticResource BotonParticipante}" Text="Añadir" />
                    </Grid>
                    <Label
                        x:Name="NombresAvisoLabel" IsVisible="False" FontSize="13" TextColor="#A12727" />
                    <ScrollView x:Name="ScrollParticipantes" IsVisible="False" Orientation="Neither">
                        <VerticalStackLayout x:Name="ListaParticipantes" Spacing="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:Participante">
                                    <Grid
                                        ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,0,8,0"
                                        HeightRequest="{x:Static views:vModoRapido.AltoFilaParticipante}">
                                        <Label
                                            FontSize="15" Text="{Binding Nombre}" TextColor="#163832"
                                            LineBreakMode="TailTruncation" MaxLines="1" VerticalTextAlignment="Center" />
                                        <Button
                                            Grid.Column="1" Clicked="QuitarNombre" CommandParameter="{Binding .}"
                                            Style="{StaticResource BotonParticipante}" Text="Quitar" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </Border>
            <Border BackgroundColor="#FFF1C1" Style="{StaticResource VaquitaCard}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border
                            Padding="10" BackgroundColor="White" HeightRequest="52" Stroke="#163832"
                            StrokeShape="RoundRectangle 16" StrokeThickness="2" WidthRequest="52">
                            <Image Source="receipt_icon.png" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold" FontSize="18" Text="Total de la cuenta" TextColor="#163832" />
                            <Label
                                FontSize="11" Text="Puedes corregirlo antes de jugar" TextColor="#6B7C78" />
                        </VerticalStackLayout>
                    </Grid>
                    <Border Style="{StaticResource VaquitaInputBorder}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Label
                                Margin="6,0" FontSize="25" Text="$" TextColor="#163832"
                                VerticalTextAlignment="Center" />
                            <controls:MontoEntry
                                x:Name="TotalEntry" Grid.Column="1" FontSize="24" Keyboard="Numeric"
                                Placeholder="84.60"
                                Style="{StaticResource VaquitaEntry}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </Border>
            <Border
                Padding="12" BackgroundColor="#DDF8F4" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="7">
                    <Image
                        HeightRequest="20" Source="check_icon.png" WidthRequest="20" />
                    <Label
                        FontAttributes="Bold" FontSize="12" Text="Sin registro; guardado solo en este teléfono" TextColor="#27736A"
                        VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </Border>
            <Button
                Clicked="Continuar_Clicked"
                Style="{StaticResource VaquitaButton}"
                Text="Continuar" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
